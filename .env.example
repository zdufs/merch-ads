# MerchAds / Merch Ads — credentials and account ids.
#
# Copy this file to `.env` and fill in your own values:
#     cp .env.example .env
#
# `.env` is gitignored and must NEVER be committed. It is the only place secrets
# live. The Python engine reads it; the Swift app never touches it.
#
# How to obtain every value below: docs/api-access-setup.md

# ---------------------------------------------------------------------------
# 1. Login with Amazon security profile (developer.amazon.com)
# ---------------------------------------------------------------------------
AMZN_ADS_CLIENT_ID=amzn1.application-oa2-client.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
AMZN_ADS_CLIENT_SECRET=amzn1.oa2-cs.v1.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---------------------------------------------------------------------------
# 2. Long-lived refresh token (produced by `python3 get_token.py`)
# ---------------------------------------------------------------------------
AMZN_ADS_REFRESH_TOKEN=Atzr|xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---------------------------------------------------------------------------
# 3. Advertising profile ids — one per marketplace you advertise in.
#    List the ones your account can see with: python3 list_profiles.py
#    Leave a market blank (or delete the line) to skip it entirely. The nightly
#    job only runs markets whose profile id is present here.
# ---------------------------------------------------------------------------
AMZN_ADS_PROFILE_ID_US=
AMZN_ADS_PROFILE_ID_UK=
AMZN_ADS_PROFILE_ID_DE=
AMZN_ADS_PROFILE_ID_FR=
AMZN_ADS_PROFILE_ID_ES=
AMZN_ADS_PROFILE_ID_IT=

# ---------------------------------------------------------------------------
# 4. Optional: KDP (books) as a separate advertiser profile.
#    Adds a "KDP US" account to the app's profile switcher. Leave blank to skip.
# ---------------------------------------------------------------------------
AMZN_ADS_PROFILE_ID_US_KDP=

# ---------------------------------------------------------------------------
# 5. Optional: Discord webhook for the nightly digest.
#    Leave blank to skip Discord entirely. You can also silence it without
#    removing the value by creating an empty file named NO_DISCORD in this folder.
# ---------------------------------------------------------------------------
DISCORD_WEBHOOK_URL=
