<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>io.github.zdufs.merchads</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>__ADS_REPO__/run_scheduled.sh</string>
    </array>
    <!-- daily at 10:00 local -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>10</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>
    <key>RunAtLoad</key>
    <false/>
    <key>StandardOutPath</key>
    <string>__ADS_REPO__/outputs/launchd.out.log</string>
    <key>StandardErrorPath</key>
    <string>__ADS_REPO__/outputs/launchd.err.log</string>
</dict>
</plist>
